{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KronoLatchTripDAG",
  "description": "Strict schema for KronoLatch deterministic trip DAG itineraries, leeway parameters, vendor audits, and group expense ledgers.",
  "type": "object",
  "required": ["trip_id", "title", "destination", "base_currency", "travelers", "nodes"],
  "properties": {
    "trip_id": {
      "type": "string",
      "description": "Unique identifier for the trip corridor"
    },
    "title": {
      "type": "string",
      "description": "Human-readable title of the itinerary"
    },
    "destination": {
      "type": "string",
      "description": "Primary region or corridor"
    },
    "base_currency": {
      "type": "string",
      "enum": ["EUR", "PLN", "USD", "GBP", "CHF", "JPY"],
      "default": "EUR"
    },
    "travelers": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "parameters": {
      "type": "object",
      "properties": {
        "risk_multiplier": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.20,
          "description": "Proportional risk multiplier alpha_risk applied to transit legs"
        },
        "hub_overhead_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 240,
          "default": 15,
          "description": "Default station/terminal queue overhead in minutes"
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/TripNode"
      },
      "minItems": 1
    },
    "expenses": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Expense"
      },
      "default": []
    },
    "vendor_checks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/VendorCheck"
      },
      "default": []
    }
  },
  "definitions": {
    "TripNode": {
      "type": "object",
      "required": ["id", "title", "type", "category", "duration_min"],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["fixed", "flexible"]
        },
        "category": {
          "type": "string",
          "enum": ["flight", "rail", "bus", "car", "walk", "sightseeing", "food", "lodging", "other"]
        },
        "transit_mode": {
          "type": "string",
          "enum": ["flight", "train", "bus", "car", "walk", "none"],
          "default": "walk"
        },
        "transit_min": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Base travel duration to reach this node from the previous stop"
        },
        "duration_min": {
          "type": "integer",
          "minimum": 1,
          "description": "Scheduled duration at this location"
        },
        "min_duration_min": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum compressible duration for flexible nodes during delay optimization"
        },
        "ideal_duration_min": {
          "type": "integer",
          "minimum": 1
        },
        "fixed_start_min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2880,
          "description": "Strict scheduled departure/entry time in minutes from day start (e.g., 930 for 15:30)"
        },
        "fixed_start_time": {
          "type": "string",
          "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
          "description": "HH:MM format for fixed nodes"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 5,
          "description": "Priority score (1 is lowest priority / first to trim; 10 is mission-critical)"
        },
        "pnr": {
          "type": "string"
        },
        "official_domain": {
          "type": "string"
        },
        "booking_url": {
          "type": "string",
          "format": "uri"
        },
        "active": {
          "type": "boolean",
          "default": true
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "Expense": {
      "type": "object",
      "required": ["id", "title", "payer", "amount", "currency", "participants"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "payer": { "type": "string" },
        "amount": { "type": "number", "minimum": 0.01 },
        "currency": { "type": "string" },
        "exchange_rate_to_base": { "type": "number", "default": 1.0 },
        "participants": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "node_id": { "type": "string" },
        "weights": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "VendorCheck": {
      "type": "object",
      "required": ["venue", "candidate_url", "status"],
      "properties": {
        "venue": { "type": "string" },
        "candidate_url": { "type": "string" },
        "official_domain": { "type": "string" },
        "official_base_price": { "type": "number" },
        "candidate_price": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["VERIFIED_OFFICIAL", "TRUSTED_AGGREGATOR", "HIGH_RISK_CLONE", "UNVERIFIED_THIRD_PARTY"]
        },
        "markup_percent": { "type": "number" },
        "flags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
